    (lf13 (sha256 (concat (sha256 fb12) (sha256 seed))))
    (fb13 (climb-l13 lf13 fb12))
    (fv13 (qadd (qmul fv12 v1) (qmulm (qinv-hint v2 hint) u8191)))
    (lf14 (sha256 (concat (sha256 fb13) (sha256 seed))))
    (fb14 (climb-l14 lf14 fb13))
    (fv14 (qadd (qmul fv13 v1) (qmulm (qinv-hint v2 hint) u8191)))
    (lf15 (sha256 (concat (sha256 fb14) (sha256 seed))))
    (fb15 (climb-l15 lf15 fb14))
    (fv15 (qadd (qmul fv14 v1) (qmulm (qinv-hint v2 hint) u8191)))
  ) (sha256 (concat fb15 (sha256 seed)))))
